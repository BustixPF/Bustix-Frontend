# URL real del backend (Nest corre en :3000 por defecto). Server-side only —
# usada en next.config.ts para el rewrite de /api/*, el navegador nunca la ve.
# El frontend corre en :3001 (ver "dev"/"start" en package.json) para no chocar.
# En Vercel, este mismo nombre debe apuntar a la URL de Railway.
BACKEND_URL=http://localhost:3000
